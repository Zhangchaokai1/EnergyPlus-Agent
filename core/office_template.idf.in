Output:SQLite,
  Simple;

! Total ideal-loads heating/cooling (sensible + latent) aggregated across all zones.
! Cooling:EnergyTransfer alone is sensible-only; in humid Nanjing the latent
! (dehumidification) load is ~25% of cooling, so we meter the supply-air TOTAL.
Meter:Custom,
  IdealTotalHeating,
  Generic,
  *,
  Zone Ideal Loads Supply Air Total Heating Energy;

Meter:Custom,
  IdealTotalCooling,
  Generic,
  *,
  Zone Ideal Loads Supply Air Total Cooling Energy;

Output:Meter,
  Electricity:Facility,
  Daily;

Output:Meter,
  InteriorLights:Electricity,
  Daily;

Output:Meter,
  InteriorEquipment:Electricity,
  Daily;

Output:Meter,
  Heating:EnergyTransfer,
  Daily;

Output:Meter,
  Cooling:EnergyTransfer,
  Daily;

Output:Meter,
  IdealTotalHeating,
  Daily;

Output:Meter,
  IdealTotalCooling,
  Daily;

Output:Variable,
  *,
  Zone Thermal Comfort Fanger Model PMV,
  Hourly;

Output:Variable,
  *,
  Zone People Occupant Count,
  Hourly;
